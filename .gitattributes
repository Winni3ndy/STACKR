# Auto detect text files and perform LF normalization
* text=auto

# Rust
*.rs text eol=lf
*.toml text eol=lf
Cargo.lock text eol=lf

# Shell scripts
*.sh text eol=lf

# SQL
*.sql text eol=lf

# Configuration
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Documentation
*.md text eol=lf

# Ensure Unix line endings for deployment files
deploy/* text eol=lf
scripts/* text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary

# Archive files
*.zip binary
*.tar binary
*.gz binary
